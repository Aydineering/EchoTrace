def get_animal_info():

    animal_type = input("Enter animal type: ").strip().title()
    animal_id = input("Enter animal ID: ").strip()

    return animal_type, animal_id


def identify_temperature_range(animal_type):

    if animal_type not in species_ranges:
        return None, None

    temp_min = species_ranges[animal_type][0]
    temp_max = species_ranges[animal_type][1]

    return temp_min, temp_max


def calculate_temperature_status(body_temp, temp_min, temp_max):

    if temp_min is None or temp_max is None:
        return "Unknown"

    if body_temp < temp_min:
        return "Low"

    elif body_temp > temp_max:
        return "High"

    else:
        return "Normal"